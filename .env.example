# AgentHub 环境变量配置
# 复制此文件为 .env 并根据需要修改

# SQLite 数据库路径（默认使用项目根目录下的 dev.db）
DATABASE_URL="file:./dev.db"

# ── E2E 测试凭证（可选） ──────────────────────────────
# 未设置时 tests/e2e-contract.test.ts 自动 skip,不影响 CI
# 启用方法:E2E=1 npx vitest run tests/e2e-contract.test.ts
# MIMO_TEST_API_KEY=tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MIMO_TEST_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
# MIMO_TEST_MODEL=mimo-v2.5-pro[1m]

# ── 决策快模型通道（ISSUE-028，可选） ─────────────────────
# 设定 AGENTHUB_DECISION_MODEL 即启用：决策/任务拆解等结构化 LLM 调用改走
# OpenAI 兼容 /chat/completions 直连（非推理快模型，绕开推理模型 JSON 不稳定问题）。
# 未设定时走原 CLI 线路（行为不变）。凭据缺省复用 Orchestrator Agent 的数据库配置，
# 也可用下面两个变量显式覆盖（key 只经 env/DB 传递，勿写进任何文件提交）。
# AGENTHUB_DECISION_MODEL=qwen3.8-flash
# AGENTHUB_DECISION_BASE_URL=https://your-gateway.example.com/v1
# AGENTHUB_DECISION_API_KEY=
